## Frontend (Vite)
# WalletConnect Project ID (recommended for production). For local demo it can be omitted.
VITE_WALLETCONNECT_PROJECT_ID=

# Optional public RPC URLs per testnet (used by wagmi transports).
VITE_RPC_URL_BASE_SEPOLIA=
VITE_RPC_URL_OPTIMISM_SEPOLIA=
VITE_RPC_URL_ARBITRUM_SEPOLIA=

## Hardhat deploy (scripts/deploy.ts)
DEPLOYER_PRIVATE_KEY=
RPC_URL_BASE_SEPOLIA=
RPC_URL_OPTIMISM_SEPOLIA=
RPC_URL_ARBITRUM_SEPOLIA=

## Agent script (scripts/agents/runAgents.ts)
AGENT_PRIVATE_KEY=
# Plant-floor seller (defaults to Hardhat account #1 on local chain)
SELLER_PRIVATE_KEY=
AGENT_ORIGIN_NODE=tokyo-gpu
CHAIN_ID=31337
RPC_URL=http://127.0.0.1:8545

